# .gitignore -- raiz do projeto Futebol
*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/src/node_modules
/src/public/build
/src/public/hot
/src/public/storage
/src/storage/*.key
/src/vendor
/src/storage/pail
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Metadado de download do Windows. No WSL o nome tem ":", no git do Windows
# vira o caractere U+F03A, por isso o padrao nao usa o ":"
*Zone.Identifier
chat_*.md

/backup/

# Assinaturas de responsáveis: dados pessoais, não versionar
# (o .gitkeep mantém a pasta no clone, porque o AssinaturaController grava nela sem criá-la)
/src/public/futebol/images/Assinaturas/*
!/src/public/futebol/images/Assinaturas/.gitkeep

# Fotos da comissão técnica enviadas pelo admin (dados pessoais; cada servidor tem as suas)
/src/public/futebol/images/comissao/*
!/src/public/futebol/images/comissao/.gitkeep

# Imagens tratadas e gravadas pelo painel com nome gerado (TratadorDeImagem): cada servidor tem as suas
/src/public/futebol/images/**/logo-time-*
/src/public/futebol/images/**/logo-campeonato-*
/src/public/futebol/images/**/banner-campeonato-*
/src/public/futebol/images/**/banner-site-*
/src/public/futebol/images/**/foto-atleta-*
